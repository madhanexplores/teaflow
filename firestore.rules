rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidSale(data, userId) {
      return data.keys().hasAll(['userId', 'amount', 'date', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'amount', 'date', 'note', 'createdAt', 'updatedAt']) &&
             data.userId == userId &&
             data.amount is number &&
             data.amount >= 0 &&
             data.amount <= 100000000 &&
             data.date is string &&
             data.date.size() == 10 &&
             data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             (!('note' in data) || (data.note is string && data.note.size() <= 250)) &&
             data.createdAt is string &&
             data.createdAt.size() <= 64 &&
             data.updatedAt is string &&
             data.updatedAt.size() <= 64;
    }

    function isValidExpense(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'amount', 'category', 'date', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'name', 'amount', 'category', 'date', 'description', 'createdAt', 'updatedAt']) &&
             data.userId == userId &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 120 &&
             data.amount is number &&
             data.amount >= 0 &&
             data.amount <= 100000000 &&
             data.category is string &&
             data.category.size() > 0 &&
             data.category.size() <= 60 &&
             data.date is string &&
             data.date.size() == 10 &&
             data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             (!('description' in data) || (data.description is string && data.description.size() <= 250)) &&
             data.createdAt is string &&
             data.createdAt.size() <= 64 &&
             data.updatedAt is string &&
             data.updatedAt.size() <= 64;
    }

    function isValidSettings(data, userId) {
      return data.keys().hasAll(['userId', 'shopName', 'currency', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'shopName', 'currency', 'customCategories', 'theme', 'defaultDateFilter', 'updatedAt']) &&
             data.userId == userId &&
             data.shopName is string &&
             data.shopName.size() > 0 &&
             data.shopName.size() <= 80 &&
             data.currency is string &&
             data.currency.size() <= 10 &&
             (!('theme' in data) || (data.theme is string && data.theme.size() <= 10)) &&
             (!('defaultDateFilter' in data) || (data.defaultDateFilter is string && data.defaultDateFilter.size() <= 20)) &&
             (!('customCategories' in data) || (data.customCategories is list && data.customCategories.size() <= 50)) &&
             data.updatedAt is string &&
             data.updatedAt.size() <= 64;
    }

    function isValidWorker(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'wageType', 'wageAmount', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'name', 'phone', 'wageType', 'wageAmount', 'offDayPaid', 'prorationMethod', 'joiningDate', 'notes', 'status', 'createdAt', 'updatedAt']) &&
             data.userId == userId &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 120 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 25)) &&
             data.wageType in ['daily', 'monthly'] &&
             data.wageAmount is number &&
             data.wageAmount >= 0 &&
             data.wageAmount <= 100000000 &&
             (!('offDayPaid' in data) || data.offDayPaid is bool) &&
             (!('prorationMethod' in data) || data.prorationMethod in ['calendar_days', 'fixed_30', 'working_26']) &&
             (!('joiningDate' in data) || (data.joiningDate is string && data.joiningDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 250)) &&
             data.status in ['active', 'inactive'] &&
             data.createdAt is string &&
             data.createdAt.size() <= 64 &&
             data.updatedAt is string &&
             data.updatedAt.size() <= 64;
    }

    function isValidAttendance(data, userId) {
      return data.keys().hasAll(['userId', 'workerId', 'date', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'workerId', 'workerName', 'date', 'status', 'wageMultiplier', 'notes', 'createdAt', 'updatedAt']) &&
             data.userId == userId &&
             data.workerId is string &&
             data.workerId.size() <= 128 &&
             (!('workerName' in data) || (data.workerName is string && data.workerName.size() <= 120)) &&
             data.date is string &&
             data.date.size() == 10 &&
             data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.status in ['present', 'half_day', 'absent', 'off'] &&
             (!('wageMultiplier' in data) || data.wageMultiplier is number) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 250)) &&
             data.createdAt is string &&
             data.createdAt.size() <= 64 &&
             data.updatedAt is string &&
             data.updatedAt.size() <= 64;
    }

    function isValidShopStatus(data, userId) {
      return data.keys().hasAll(['userId', 'date', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'date', 'status', 'isPaid', 'holidayName', 'createdAt', 'updatedAt']) &&
             data.userId == userId &&
             data.date is string &&
             data.date.size() == 10 &&
             data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.status in ['open', 'holiday', 'weekly_off'] &&
             (!('isPaid' in data) || data.isPaid is bool) &&
             (!('holidayName' in data) || (data.holidayName is string && data.holidayName.size() <= 120)) &&
             data.createdAt is string &&
             data.createdAt.size() <= 64 &&
             data.updatedAt is string &&
             data.updatedAt.size() <= 64;
    }

    function isValidSalaryAdvance(data, userId) {
      return data.keys().hasAll(['userId', 'workerId', 'amount', 'type', 'date', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'workerId', 'workerName', 'amount', 'type', 'date', 'reason', 'createdAt', 'updatedAt']) &&
             data.userId == userId &&
             data.workerId is string &&
             data.workerId.size() <= 128 &&
             (!('workerName' in data) || (data.workerName is string && data.workerName.size() <= 120)) &&
             data.amount is number &&
             data.amount >= 0 &&
             data.amount <= 100000000 &&
             data.type in ['advance', 'deduction'] &&
             data.date is string &&
             data.date.size() == 10 &&
             data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             (!('reason' in data) || (data.reason is string && data.reason.size() <= 250)) &&
             data.createdAt is string &&
             data.createdAt.size() <= 64 &&
             data.updatedAt is string &&
             data.updatedAt.size() <= 64;
    }

    function isValidSalaryPayment(data, userId) {
      return data.keys().hasAll(['userId', 'workerId', 'month', 'amount', 'paymentDate', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'workerId', 'workerName', 'month', 'amount', 'paymentDate', 'expenseId', 'notes', 'createdAt', 'updatedAt']) &&
             data.userId == userId &&
             data.workerId is string &&
             data.workerId.size() <= 128 &&
             (!('workerName' in data) || (data.workerName is string && data.workerName.size() <= 120)) &&
             data.month is string &&
             data.month.size() == 7 &&
             data.month.matches('^[0-9]{4}-[0-9]{2}$') &&
             data.amount is number &&
             data.amount >= 0 &&
             data.amount <= 100000000 &&
             data.paymentDate is string &&
             data.paymentDate.size() == 10 &&
             data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             (!('expenseId' in data) || (data.expenseId is string && data.expenseId.size() <= 128)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 250)) &&
             data.createdAt is string &&
             data.createdAt.size() <= 64 &&
             data.updatedAt is string &&
             data.updatedAt.size() <= 64;
    }

    // --- Match Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);

      match /sales/{saleId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(saleId) && isValidSale(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(saleId) && isValidSale(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(saleId);
      }

      match /expenses/{expenseId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(expenseId) && isValidExpense(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(expenseId) && isValidExpense(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(expenseId);
      }

      match /settings/{settingDoc} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSettings(incoming(), userId);
        allow update: if isOwner(userId) && isValidSettings(incoming(), userId) &&
                         incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      match /workers/{workerId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(workerId) && isValidWorker(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(workerId) && isValidWorker(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(workerId);
      }

      match /attendance/{attendanceId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(attendanceId) && isValidAttendance(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(attendanceId) && isValidAttendance(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(attendanceId);
      }

      match /shopStatus/{dateId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(dateId) && isValidShopStatus(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(dateId);
      }

      match /salaryAdvances/{advanceId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(advanceId) && isValidSalaryAdvance(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(advanceId) && isValidSalaryAdvance(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(advanceId);
      }

      match /salaryPayments/{paymentId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(paymentId) && isValidSalaryPayment(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(paymentId) && isValidSalaryPayment(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(paymentId);
      }
    }
  }
}
